## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

# Mono Auto Generated Files
mono_crash.*

# Build results
[Bb]in/
[Oo]bj/
build/
out/

# Visual Studio cache files
.vs/

# Visual Studio database files
*.VC.db
*.VC.opendb

# Rider
.idea/
*.sln.iml

# ReSharper
_ReSharper*/
*.DotSettings.user

# NCrunch
*.ncrunch*

# Coverlet
coverage*.json
coverage*.info
coverage*.xml
coverage*.html

# MSTest test Results
TestResults/
*.trx

# NUnit
*.VisualState.xml
TestResult.xml
nunit-*.xml

# Build artifacts
*.dll
*.exe
*.app
*.so
*.dylib
*.a
*.lib

# Explicitly include BergerBytes.App folder
!BergerBytes.App/

# NuGet
packages/
*.nupkg
project.lock.json
project.fragment.lock.json
.nuget/

# Dotnet Core
project.assets.json
project.nuget.cache
# Visual Studio cache for dotnet SDK
artifacts/
*.runtimeconfig.json
*.deps.json
runtimeconfig*.json

# Publish output
publish/

# Azure
.azure/

# SQL Server files
*.mdf
*.ldf

# Visual Studio Code workspace settings
.vscode/

# Rider caches
.idea/
*.sln.iml

# DotCover
*.dotCover

# StyleCop
StyleCopReport.xml

# Windows image file caches
Thumbs.db
ehthumbs.db

# Folder config file
Desktop.ini

# JetBrains Rider
.idea/
.idea/*
*.sln.iml

# Windows Installer files
*.cab
*.msi
*.msm
*.msp

# Other files to ignore
*.log
*.vsix

# Exclude local Secrets file used by Visual Studio
secrets.json

# End of official VisualStudio gitignore template
