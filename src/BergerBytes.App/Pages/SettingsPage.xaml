<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BergerBytes.App.Pages.SettingsPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="24,32"
            Spacing="20">

            <Label
                Text="⚙️ Settings"
                FontSize="28"
                FontAttributes="Bold"
                TextColor="{StaticResource BrandPrimary}"
                HorizontalOptions="Start" />

            <Label
                Text="Customize your daily nutrition goals."
                FontSize="16"
                TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />

            <!-- Daily Goals Section -->
            <Label Text="Daily Goals" FontSize="20" FontAttributes="Bold" 
                   TextColor="{StaticResource BrandPrimary}" Margin="0,8,0,0" />

            <Border
                Stroke="{StaticResource BrandPrimaryBrush}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 12"
                Padding="16">
                <VerticalStackLayout Spacing="16">

                    <!-- Calorie Goal -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Daily Calorie Goal (kcal)" FontSize="14" 
                               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                        <HorizontalStackLayout Spacing="12">
                            <Entry Text="{Binding DailyCalorieGoalText}" 
                                   Keyboard="Numeric"
                                   Placeholder="0 = no goal"
                                   WidthRequest="120"
                                   HorizontalOptions="Start" />
                            <Label Text="kcal" FontSize="16" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1"
                             Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" />

                    <!-- Protein Goal -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Daily Protein Goal (g)" FontSize="14" 
                               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                        <HorizontalStackLayout Spacing="12">
                            <Entry Text="{Binding DailyProteinGoalText}" 
                                   Keyboard="Numeric"
                                   Placeholder="0 = no goal"
                                   WidthRequest="120"
                                   HorizontalOptions="Start" />
                            <Label Text="grams" FontSize="16" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1"
                             Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" />

                    <!-- Carbs Goal -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Daily Carbs Goal (g)" FontSize="14" 
                               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                        <HorizontalStackLayout Spacing="12">
                            <Entry Text="{Binding DailyCarbsGoalText}" 
                                   Keyboard="Numeric"
                                   Placeholder="0 = no goal"
                                   WidthRequest="120"
                                   HorizontalOptions="Start" />
                            <Label Text="grams" FontSize="16" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1"
                             Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" />

                    <!-- Fat Goal -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Daily Fat Goal (g)" FontSize="14" 
                               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                        <HorizontalStackLayout Spacing="12">
                            <Entry Text="{Binding DailyFatGoalText}" 
                                   Keyboard="Numeric"
                                   Placeholder="0 = no goal"
                                   WidthRequest="120"
                                   HorizontalOptions="Start" />
                            <Label Text="grams" FontSize="16" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

            <!-- Save Button -->
            <Button
                Text="Save Settings"
                Command="{Binding SaveSettingsCommand}"
                BackgroundColor="{StaticResource BrandPrimary}"
                TextColor="{StaticResource White}"
                CornerRadius="12"
                HeightRequest="52"
                FontAttributes="Bold"
                FontSize="16" />

            <!-- App Preferences Section -->
            <Label Text="Appearance" FontSize="20" FontAttributes="Bold" 
                   TextColor="{StaticResource BrandPrimary}" Margin="0,16,0,0" />

            <Border
                Stroke="{StaticResource BrandPrimaryBrush}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 12"
                Padding="16">
                <HorizontalStackLayout Spacing="12">
                    <Label Text="Dark Mode" FontSize="16" VerticalOptions="Center"
                           HorizontalOptions="Fill" HorizontalTextAlignment="Start" />
                    <Switch IsToggled="{Binding DarkModeEnabled}" 
                            OnColor="{StaticResource BrandPrimary}"
                            HorizontalOptions="End" />
                </HorizontalStackLayout>
            </Border>

            <!-- Account Section (Placeholder) -->
            <Label Text="Account" FontSize="20" FontAttributes="Bold" 
                   TextColor="{StaticResource BrandPrimary}" Margin="0,16,0,0" />

            <Button
                Text="Sign In with Google"
                BackgroundColor="{StaticResource BrandSecondary}"
                TextColor="{StaticResource White}"
                CornerRadius="12"
                HeightRequest="52"
                FontAttributes="Bold"
                FontSize="16"
                IsEnabled="False" />

            <Label Text="Cloud sync coming soon!" 
                   FontSize="12" 
                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                   HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
