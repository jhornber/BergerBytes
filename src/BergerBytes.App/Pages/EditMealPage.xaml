<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:System="clr-namespace:System;assembly=netstandard"
             x:Class="BergerBytes.App.Pages.EditMealPage"
             Title="Edit Meal">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="20">

            <!-- Header -->
            <Label Text="✏️ Edit Meal" 
                   FontSize="28" 
                   FontAttributes="Bold"
                   TextColor="{StaticResource BrandPrimary}" />

            <!-- Meal Type Selection -->
            <VerticalStackLayout Spacing="8">
                <Label Text="Meal Type" FontSize="16" FontAttributes="Bold" />
                <Picker SelectedIndex="{Binding SelectedMealTypeIndex}"
                        Title="Select Meal Type"
                        FontSize="16">
                    <Picker.ItemsSource>
                        <x:Array Type="{x:Type x:String}">
                            <x:String>🌅 Breakfast</x:String>
                            <x:String>☀️ Lunch</x:String>
                            <x:String>🌙 Dinner</x:String>
                            <x:String>🍽️ Other</x:String>
                        </x:Array>
                    </Picker.ItemsSource>
                </Picker>
            </VerticalStackLayout>

            <!-- Date and Time Selection -->
            <Border Stroke="{StaticResource Gray300Brush}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 12"
                    Padding="16"
                    BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="📅 When did you eat this?" 
                           FontSize="16" 
                           FontAttributes="Bold" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <!-- Date Picker -->
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="Date" FontSize="14" />
                            <DatePicker Date="{Binding MealDate}"
                                       Format="MMM dd, yyyy"
                                       FontSize="16"
                                       MaximumDate="{x:Static System:DateTime.Today}" />
                        </VerticalStackLayout>

                        <!-- Time Picker -->
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Time" FontSize="14" />
                            <TimePicker Time="{Binding MealTime}"
                                       Format="h:mm tt"
                                       FontSize="16" />
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" />

            <!-- Food Items Section -->
            <VerticalStackLayout Spacing="12">
                <Label Text="Food Items" FontSize="20" FontAttributes="Bold" />

                <!-- Scanned Barcode Display -->
                <Border IsVisible="{Binding HasScannedBarcode}"
                        Stroke="{StaticResource BrandSecondaryBrush}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 8"
                        Padding="12"
                        Margin="0,8,0,0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <Label Grid.Column="0" 
                               Text="???" 
                               FontSize="20" 
                               VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               Text="{Binding ScannedBarcode, StringFormat='Barcode: {0}'}"
                               FontSize="14"
                               TextColor="{StaticResource Gray600}"
                               VerticalOptions="Center" />
                        <Button Grid.Column="2"
                                Text="?"
                                Command="{Binding ClearBarcodeCommand}"
                                BackgroundColor="Transparent"
                                TextColor="{StaticResource Gray600}"
                                Padding="4"
                                WidthRequest="32"
                                HeightRequest="32" />
                    </Grid>
                </Border>

                <!-- Scan Barcode Button -->
                <Button Text="?? Scan Barcode to Add Item"
                        Command="{Binding ScanBarcodeCommand}"
                        BackgroundColor="{StaticResource BrandSecondary}"
                        TextColor="White"
                        CornerRadius="8"
                        HeightRequest="44"
                        Margin="0,8,0,8"
                        IsEnabled="{Binding IsLoadingProduct, Converter={StaticResource InvertedBoolConverter}}" />

                <!-- Loading Indicator -->
                <ActivityIndicator IsRunning="{Binding IsLoadingProduct}"
                                  IsVisible="{Binding IsLoadingProduct}"
                                  Color="{StaticResource BrandPrimary}"
                                  HeightRequest="40" />

                <!-- Items List -->
                <VerticalStackLayout Spacing="8"
                                    BindableLayout.ItemsSource="{Binding MealItems}">
                    <BindableLayout.EmptyView>
                        <Label Text="All items removed. Saving will delete this meal."
                               FontSize="14"
                               TextColor="{StaticResource Gray600}"
                               HorizontalOptions="Center"
                               Margin="0,16" />
                    </BindableLayout.EmptyView>
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <SwipeView>
                                <SwipeView.RightItems>
                                    <SwipeItems>
                                        <SwipeItem Text="Remove"
                                                  BackgroundColor="Red"
                                                  Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteItemCommand}"
                                                  CommandParameter="{Binding .}" />
                                    </SwipeItems>
                                </SwipeView.RightItems>

                                <Border Padding="12"
                                        Stroke="{StaticResource Gray300Brush}"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 8"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray800}}">
                                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">

                                        <!-- Food Name -->
                                        <Label Grid.Row="0" Grid.Column="0"
                                               Text="{Binding FoodName}"
                                               FontSize="16"
                                               FontAttributes="Bold" />

                                        <!-- Calories -->
                                        <Label Grid.Row="0" Grid.Column="1"
                                               Text="{Binding Calories, StringFormat='{0:F0} cal'}"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource BrandPrimary}"
                                               VerticalOptions="Center" />

                                        <!-- Macros -->
                                        <HorizontalStackLayout Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" 
                                                             Spacing="12" 
                                                             Margin="0,4,0,0">
                                            <Label Text="{Binding Protein, StringFormat='P: {0:F1}g'}" 
                                                   FontSize="13"
                                                   TextColor="{StaticResource Gray600}" />
                                            <Label Text="{Binding Carbs, StringFormat='C: {0:F1}g'}" 
                                                   FontSize="13"
                                                   TextColor="{StaticResource Gray600}" />
                                            <Label Text="{Binding Fat, StringFormat='F: {0:F1}g'}" 
                                                   FontSize="13"
                                                   TextColor="{StaticResource Gray600}" />
                                        </HorizontalStackLayout>

                                    </Grid>
                                </Border>
                            </SwipeView>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

            </VerticalStackLayout>

            <!-- Total Summary -->
            <Border Stroke="{StaticResource BrandPrimaryBrush}"
                    StrokeThickness="2"
                    StrokeShape="RoundRectangle 12"
                    Padding="16"
                    BackgroundColor="{StaticResource BrandPrimary}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Meal Total" 
                           FontSize="18" 
                           FontAttributes="Bold"
                           TextColor="{StaticResource White}" />
                    <Label FontSize="16" TextColor="{StaticResource White}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{Binding TotalCaloriesDisplay}" FontAttributes="Bold" />
                                <Span Text="  |  " />
                                <Span Text="{Binding TotalMacrosDisplay}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </VerticalStackLayout>
            </Border>

            <!-- Action Buttons -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,12,0,24">
                <Button Grid.Column="0"
                        Text="Cancel"
                        Command="{Binding CancelCommand}"
                        BackgroundColor="{StaticResource Gray400}"
                        TextColor="{StaticResource White}"
                        CornerRadius="12"
                        HeightRequest="52" />
                <Button Grid.Column="1"
                        Text="Save Changes"
                        Command="{Binding SaveCommand}"
                        BackgroundColor="{StaticResource BrandPrimary}"
                        TextColor="{StaticResource White}"
                        CornerRadius="12"
                        HeightRequest="52"
                        FontAttributes="Bold" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
