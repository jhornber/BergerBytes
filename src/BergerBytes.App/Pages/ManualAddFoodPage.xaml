<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BergerBytes.App.Pages.ManualAddFoodPage"
             Title="Add Food Manually">

    <ScrollView>
        <VerticalStackLayout Padding="24,32" Spacing="20">

            <Label Text="✏️ Add Food Manually"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="{StaticResource BrandPrimary}" />

            <Label Text="Enter the nutritional information for your food item."
                   FontSize="15"
                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />

            <Border Stroke="{StaticResource BrandPrimaryBrush}"
                    StrokeThickness="2"
                    StrokeShape="RoundRectangle 12"
                    Padding="20"
                    BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}">
                <VerticalStackLayout Spacing="16">

                    <!-- Food Name -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Food Name *"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="{StaticResource BrandPrimary}" />
                        <Entry Text="{Binding FoodName}"
                               Placeholder="e.g., Chocolate Chip Granola Bar"
                               FontSize="15" />
                    </VerticalStackLayout>

                    <!-- Brand Name -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Brand Name (Optional)"
                               FontSize="14"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                        <Entry Text="{Binding BrandName}"
                               Placeholder="e.g., Clif Bar"
                               FontSize="15" />
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1"
                             Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" />

                    <!-- Serving Unit -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Serving Unit *"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="{StaticResource BrandPrimary}" />
                        <Entry Text="{Binding Unit}"
                               Placeholder="each"
                               FontSize="15" />
                        <Label Text="e.g., each, bar, cup, slice, oz"
                               FontSize="11"
                               TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}" />
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1"
                             Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" />

                    <!-- Per Serving header -->
                    <Label Text="Nutrition Per Serving"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />

                    <!-- Calories per serving -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Calories *"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="{StaticResource BrandPrimary}" />
                        <Entry Text="{Binding CaloriesPerServing}"
                               Keyboard="Numeric"
                               Placeholder="e.g., 250"
                               FontSize="15" />
                    </VerticalStackLayout>

                    <!-- Macros per serving -->
                    <Label Text="Macros (Optional)"
                           FontSize="13"
                           FontAttributes="Italic"
                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="Protein (g)"
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                            <Entry Text="{Binding ProteinPerServing}"
                                   Keyboard="Numeric"
                                   Placeholder="0"
                                   FontSize="14" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Carbs (g)"
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                            <Entry Text="{Binding CarbsPerServing}"
                                   Keyboard="Numeric"
                                   Placeholder="0"
                                   FontSize="14" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2" Spacing="4">
                            <Label Text="Fat (g)"
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                            <Entry Text="{Binding FatPerServing}"
                                   Keyboard="Numeric"
                                   Placeholder="0"
                                   FontSize="14" />
                        </VerticalStackLayout>
                    </Grid>

                    <BoxView HeightRequest="1"
                             Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" />

                    <!-- Number of Servings -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Number of Servings *"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="{StaticResource BrandPrimary}" />
                        <Entry Text="{Binding NumberOfServings}"
                               Keyboard="Numeric"
                               Placeholder="1"
                               FontSize="15" />
                        <Label Text="Totals will be calculated automatically."
                               FontSize="11"
                               TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}" />
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

            <!-- Action buttons -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,4,0,24">
                <Button Grid.Column="0"
                        Text="Cancel"
                        Command="{Binding CancelCommand}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                        TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource White}}"
                        CornerRadius="12"
                        HeightRequest="52" />
                <Button Grid.Column="1"
                        Text="Add to Meal"
                        Command="{Binding SaveCommand}"
                        BackgroundColor="{StaticResource BrandPrimary}"
                        TextColor="{StaticResource White}"
                        CornerRadius="12"
                        HeightRequest="52"
                        FontAttributes="Bold" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
