<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             x:Class="BergerBytes.App.Pages.DashboardPage">

    <RefreshView IsRefreshing="{Binding IsRefreshing}"
                 Command="{Binding RefreshCommand}">
        <ScrollView>
            <VerticalStackLayout
                Padding="24,32"
                Spacing="20">

                <HorizontalStackLayout Spacing="10" HorizontalOptions="Start" VerticalOptions="Center">
                    <mi:MauiIcon Icon="{mi:Material Icon=Analytics}"
                                 IconSize="28"
                                 IconColor="{StaticResource BrandPrimary}" />
                    <Label
                        Text="Dashboard"
                        FontSize="28"
                        FontAttributes="Bold"
                        TextColor="{StaticResource BrandPrimary}"
                        VerticalOptions="Center" />
                </HorizontalStackLayout>

                <Label
                    Text="Your daily nutrition overview."
                    FontSize="16"
                    TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />

                <!-- Calories Card -->
                <Border
                    Stroke="{StaticResource BrandSecondaryBrush}"
                    StrokeThickness="2"
                    StrokeShape="RoundRectangle 12"
                    Padding="20">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Calories Today" FontSize="14"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                        <Label Text="{Binding CaloriesDisplay}" FontSize="24" FontAttributes="Bold"
                               TextColor="{StaticResource BrandSecondary}" />

                        <!-- Burned + Net (only when exercise logged) -->
                        <Grid ColumnDefinitions="*,*" IsVisible="{Binding HasCaloriesBurned}" Margin="0,4,0,0">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Burned"
                                       FontSize="11"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}" />
                                <Label Text="{Binding CaloriesBurnedDisplay}"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="#4CAF50" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="2" Grid.Column="1">
                                <Label Text="Net"
                                       FontSize="11"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}" />
                                <Label Text="{Binding NetCaloriesDisplay}"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource BrandSecondary}" />
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Progress Bar - Only show if goal is set -->
                        <ProgressBar Progress="{Binding CaloriesPercentage}" 
                                     ProgressColor="{StaticResource BrandSecondary}"
                                     HeightRequest="8"
                                     Margin="0,8,0,0"
                                     IsVisible="{Binding IsCalorieGoalSet}" />

                        <Label Text="{Binding CaloriesPercentage, StringFormat='{0:F0}% of daily goal'}" 
                               FontSize="12"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}"
                               IsVisible="{Binding IsCalorieGoalSet}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Macros Grid -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                    <Border Grid.Column="0"
                            Stroke="{StaticResource BrandPrimaryBrush}"
                            StrokeThickness="2"
                            StrokeShape="RoundRectangle 12"
                            Padding="12">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Protein" FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}"
                                   HorizontalOptions="Center" />
                            <Label Text="{Binding ProteinDisplay}" FontSize="14" FontAttributes="Bold"
                                   TextColor="{StaticResource BrandPrimary}"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1"
                            Stroke="{StaticResource BrandPrimaryBrush}"
                            StrokeThickness="2"
                            StrokeShape="RoundRectangle 12"
                            Padding="12">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Carbs" FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}"
                                   HorizontalOptions="Center" />
                            <Label Text="{Binding CarbsDisplay}" FontSize="14" FontAttributes="Bold"
                                   TextColor="{StaticResource BrandPrimary}"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="2"
                            Stroke="{StaticResource BrandPrimaryBrush}"
                            StrokeThickness="2"
                            StrokeShape="RoundRectangle 12"
                            Padding="12">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Fat" FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}"
                                   HorizontalOptions="Center" />
                            <Label Text="{Binding FatDisplay}" FontSize="14" FontAttributes="Bold"
                                   TextColor="{StaticResource BrandPrimary}"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- ═══════════════════════════════ WEIGHT SECTION ═══════════════════════════════ -->

                <Label Text="Weight"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="{StaticResource BrandPrimary}"
                       Margin="0,8,0,0" />

                <!-- No data placeholder -->
                <Label Text="No weight entries yet. Tap '⚖ Log Weight' on the Meal Log tab."
                       FontSize="14"
                       TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       IsVisible="{Binding HasWeightData, Converter={StaticResource InvertedBoolConverter}}" />

                <!-- Current Weight Card -->
                <Border IsVisible="{Binding HasWeightData}"
                        Stroke="{StaticResource BrandPrimaryBrush}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        Padding="20">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Current Weight"
                                   FontSize="14"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                            <Label Text="{Binding LastWeightDisplay}"
                                   FontSize="32"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource BrandPrimary}" />
                            <Label Text="{Binding LastWeightDateDisplay}"
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}" />
                        </VerticalStackLayout>
                        <mi:MauiIcon Grid.Column="1"
                                     Icon="{mi:Material Icon=FitnessCenter}"
                                     IconSize="40"
                                     IconColor="{StaticResource BrandPrimary}"
                                     VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- Weight Goal Card -->
                <Border IsVisible="{Binding HasWeightGoal}"
                        Stroke="{StaticResource BrandSecondaryBrush}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        Padding="20">
                    <VerticalStackLayout Spacing="12">

                        <!-- Goal header row -->
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Weight Goal"
                                       FontSize="14"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                                <Label Text="{Binding WeightGoalSummary}"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource BrandSecondary}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" HorizontalOptions="End" Spacing="2">
                                <Label Text="Pace"
                                       FontSize="11"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}"
                                       HorizontalOptions="End" />
                                <Label Text="{Binding WeightGoalPaceDisplay}"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource BrandSecondary}"
                                       HorizontalOptions="End" />
                            </VerticalStackLayout>
                        </Grid>

                        <BoxView HeightRequest="1"
                                 Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" />

                        <!-- Calorie guidance -->
                        <VerticalStackLayout Spacing="10">

                            <!-- TDEE (shown when profile is complete) -->
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12"
                                  IsVisible="{Binding HasProfileData}">
                                <Label Grid.Column="0"
                                       Text="Maintenance (TDEE)"
                                       FontSize="13"
                                       VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                                <Label Grid.Column="1"
                                       Text="{Binding TdeeDisplay}"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center"
                                       HorizontalOptions="End"
                                       TextColor="{StaticResource BrandSecondary}" />
                            </Grid>

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Label Grid.Column="0"
                                       Text="Daily Requirement"
                                       FontSize="13"
                                       VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                                <Label Grid.Column="1"
                                       Text="{Binding WeightGoalDailyDeltaDisplay}"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center"
                                       HorizontalOptions="End"
                                       TextColor="{StaticResource BrandSecondary}" />
                            </Grid>

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12"
                                  IsVisible="{Binding HasSuggestedIntake}">
                                <Label Grid.Column="0"
                                       Text="Suggested Intake"
                                       FontSize="13"
                                       VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                                <Label Grid.Column="1"
                                       Text="{Binding WeightGoalSuggestedIntakeDisplay}"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center"
                                       HorizontalOptions="End"
                                       TextColor="{StaticResource BrandPrimary}" />
                            </Grid>

                            <!-- Nudge to complete profile when TDEE is not yet available -->
                            <Label Text="Add body metrics in Settings for a personalized recommendation"
                                   FontSize="12"
                                   FontAttributes="Italic"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center"
                                   IsVisible="{Binding HasProfileData, Converter={StaticResource InvertedBoolConverter}}" />

                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Border>

                <!-- Weight History Chart (requires > 1 day of data) -->
                <Border IsVisible="{Binding HasWeightHistory}"
                        Stroke="{StaticResource BrandPrimaryBrush}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        Padding="16">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Weight History"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="{StaticResource BrandPrimary}" />
                        <GraphicsView Drawable="{Binding WeightChartDrawable}"
                                      HeightRequest="200"
                                      HorizontalOptions="Fill" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>

</ContentPage>
